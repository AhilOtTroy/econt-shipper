# Response headers for the static files when the app runs on Cloudflare
# (Workers Static Assets). The same headers the Node server (server.js) sends.
# Not served as a file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# HTML, scripts and the manifest: revalidate on every load, so a new deploy is
# picked up at once (an unchanged file still costs only a 304).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/core/*
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Fonts never change under the same file name.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/fonts/LICENSE.txt
  Cache-Control: no-cache
